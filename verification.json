{
 "about": "Checked examples: a row from a published source next to what the calculator answers. build.py runs every case through assets/calc.js (tools/verify.mjs) and stops if one is outside its tolerance; verification.html shows them all. 'checked' is the day the sources were last read against these rows: change it only after reading them again. A case: calc (key of 'calculators'), press (segment id -> data-v), set (field id -> value, or the label of a select option), oils (lye only: [oil id, grams]), read (output id), pick (which number of the output, from 0), then expect + tolerance + unit, or expect_text.",
 "checked": "2026-11-12",
 "calculators": {
  "hvac": {"page": "hvac/superheat-subcooling-calculator.html", "init": "initHvac", "name": "Superheat & subcooling calculator"},
  "awg": {"page": "electrical/awg-to-mm2.html", "init": "initAwg", "name": "AWG to mm² converter"},
  "wire": {"page": "electrical/wire-size-calculator.html", "init": "initWireSize", "name": "Wire size calculator"},
  "vd": {"page": "electrical/voltage-drop-calculator.html", "init": "initVoltageDrop", "name": "Voltage drop calculator"},
  "coat": {"page": "coating/epoxy-coverage-calculator.html", "init": "initCoat", "name": "Epoxy coverage calculator"},
  "pool": {"page": "pool/pool-chemical-calculator.html", "init": "initPool", "name": "Pool chemical calculator"},
  "lye": {"page": "soap/lye-calculator.html", "init": "initLye", "name": "Lye calculator"},
  "bread": {"page": "bread/bakers-percentage-calculator.html", "init": "initBread", "name": "Baker's percentage calculator"}
 },
 "sources": {
  "arkema": "Arkema, Forane® Refrigerants Pressure Temperature Chart, PPC/SDC 05-2025 (NIST REFPROP 10.0). Read 25.10.2026.",
  "chemours": "Chemours, Thermodynamic Properties of Opteon™ XL41 (R-454B), Engineering (I/P) Units, 1 °F steps; gauge pressure = table psia − 14.696. Values as pinned in the HVAC Charge app's tests.",
  "coolprop": "CoolProp 8.0 (NIST reference equations of state), saturation pressure. Values as pinned in the HVAC Charge app's tests.",
  "nec-t8": "NEC (NFPA 70) 2023, Chapter 9, Table 8, Conductor Properties.",
  "nec-310": "NEC (NFPA 70) 2023, Table 310.16, ampacities at 30 °C ambient, not more than three current-carrying conductors.",
  "kfactor": "K-factor voltage drop formula for copper, VD = 2 × K × I × L ÷ CM with K = 12.9 Ω·cmil/ft.",
  "iec-g": "IEC 60364-5-52, Annex G: u = b × ρ × L × I ÷ S at unity power factor, ρ = 0.0225 Ω·mm²/m for copper.",
  "gallon": "US liquid gallon = 231 cubic inches (NIST Handbook 44, Appendix C). 231 in³ spread 0.001 in thick = 1,604 sq ft.",
  "poolmath": "Trouble Free Pool, Pool Math classic calculator (troublefreepool.com/calc.html). Read 25.10.2026.",
  "soapcalc": "SoapCalc oil list and lye calculator (soapcalc.net). Snapshot of 25.10.2026.",
  "lowimpact": "The Soapery / Low Impact, simple cold process soap recipe without palm oil (lowimpact.org, 2022).",
  "bakers": "Baker's percentage, total-formula method (King Arthur Baking, Baker's percentage; Wikipedia, Baker percentage)."
 },
 "cases": [
  {"id": "hvac-r410a-40f", "calc": "hvac", "title": "R-410A: temperature at 118.8 psig", "source": "arkema", "source_says": "R-410A, 40 °F row: 118.8 psig",
   "press": {"ptmode": "p2t"}, "set": {"ref": "R-410A", "pt-in": "118.8"}, "read": "pt-out", "expect": 40.0, "tolerance": 0.05, "unit": "°F"},
  {"id": "hvac-r22-100f", "calc": "hvac", "title": "R-22: pressure at 100 °F", "source": "arkema", "source_says": "R-22, 100 °F row: 195.9 psig",
   "press": {"ptmode": "t2p"}, "set": {"ref": "R-22", "pt-in": "100"}, "read": "pt-out", "expect": 195.9, "tolerance": 0.05, "unit": "psig"},
  {"id": "hvac-r32-superheat", "calc": "hvac", "title": "R-32: superheat at 121.0 psig suction, 52 °F line", "source": "arkema", "source_says": "R-32, 40 °F row: 121.0 psig, so superheat = 52 − 40 = 12.0 °F",
   "press": {"mode": "sh"}, "set": {"ref": "R-32", "p": "121.0", "t": "52"}, "read": "out", "expect": 12.0, "tolerance": 0.05, "unit": "°F"},
  {"id": "hvac-r454b-subcooling", "calc": "hvac", "title": "R-454B: subcooling at 300.8 psig liquid, 90 °F line", "source": "arkema", "source_says": "R-454B, 100 °F row, liquid (bubble) column: 300.8 psig, so subcooling = 100 − 90 = 10.0 °F",
   "press": {"mode": "sc"}, "set": {"ref": "R-454B", "p": "300.8", "t": "90"}, "read": "out", "expect": 10.0, "tolerance": 0.05, "unit": "°F"},
  {"id": "hvac-r454b-42f-bubble", "calc": "hvac", "title": "R-454B between chart rows: bubble pressure at 42 °F", "source": "chemours", "source_says": "42 °F: 116.35 psig liquid (bubble)",
   "press": {"ptmode": "t2p"}, "set": {"ref": "R-454B", "pt-in": "42"}, "read": "pt-out", "pick": 0, "expect": 116.35, "tolerance": 0.15, "unit": "psig",
   "note": "The chart has a row every 5 °F; the calculator interpolates between rows and shows one decimal."},
  {"id": "hvac-r454b-42f-dew", "calc": "hvac", "title": "R-454B between chart rows: dew pressure at 42 °F", "source": "chemours", "source_says": "42 °F: 111.22 psig vapor (dew)",
   "press": {"ptmode": "t2p"}, "set": {"ref": "R-454B", "pt-in": "42"}, "read": "pt-out", "pick": 1, "expect": 111.22, "tolerance": 0.15, "unit": "psig"},
  {"id": "hvac-r410a-43f", "calc": "hvac", "title": "R-410A between chart rows: pressure at 43 °F", "source": "coolprop", "source_says": "43 °F: 125.777 psig",
   "press": {"ptmode": "t2p"}, "set": {"ref": "R-410A", "pt-in": "43"}, "read": "pt-out", "expect": 125.777, "tolerance": 0.3, "unit": "psig"},

  {"id": "awg-12-cmil", "calc": "awg", "title": "12 AWG in circular mils", "source": "nec-t8", "source_says": "12 AWG: 6,530 circular mils",
   "set": {"awg": "12 AWG"}, "read": "awg-cmil", "expect_text": "6,530 cmil"},
  {"id": "awg-12-mm2", "calc": "awg", "title": "12 AWG in mm²", "source": "nec-t8", "source_says": "12 AWG: 3.31 mm²",
   "set": {"awg": "12 AWG"}, "read": "awg-mm2", "expect": 3.31, "tolerance": 0.005, "unit": "mm²"},
  {"id": "awg-4-0-mm2", "calc": "awg", "title": "4/0 AWG in mm²", "source": "nec-t8", "source_says": "4/0 AWG: 211,600 circular mils, 107.2 mm²",
   "set": {"awg": "4/0 AWG"}, "read": "awg-mm2", "expect": 107.2, "tolerance": 0.05, "unit": "mm²"},

  {"id": "wire-50a-thhn", "calc": "wire", "title": "50 A load, copper THHN, 75 °C terminals", "source": "nec-310", "source_says": "Copper, 75 °C column: 8 AWG = 50 A",
   "set": {"amps": "50", "wire": "thhn"}, "read": "ws-size", "expect_text": "8 AWG copper"},
  {"id": "wire-30a-thhn", "calc": "wire", "title": "30 A load, copper THHN, 75 °C terminals", "source": "nec-310", "source_says": "Copper, 75 °C column: 10 AWG = 35 A; 240.4(D) limits 10 AWG copper to a 30 A breaker",
   "set": {"amps": "30", "wire": "thhn"}, "read": "ws-size", "expect_text": "10 AWG copper"},
  {"id": "wire-40a-nmb", "calc": "wire", "title": "40 A load on NM-B cable", "source": "nec-310", "source_says": "Copper, 60 °C column (NM-B, NEC 334.80): 8 AWG = 40 A",
   "set": {"amps": "40", "wire": "nmb"}, "read": "ws-size", "expect_text": "8 AWG copper"},
  {"id": "wire-48a-continuous", "calc": "wire", "title": "48 A continuous load (EV charger), copper THHN", "source": "nec-310", "source_says": "125 % of 48 A = 60 A (NEC 210.19); copper, 75 °C column: 6 AWG = 65 A",
   "press": {"cont": "yes"}, "set": {"amps": "48", "wire": "thhn"}, "read": "ws-size", "expect_text": "6 AWG copper"},
  {"id": "wire-48a-breaker", "calc": "wire", "title": "48 A continuous load: breaker", "source": "nec-310", "source_says": "125 % of 48 A = 60 A (NEC 210.19)",
   "press": {"cont": "yes"}, "set": {"amps": "48", "wire": "thhn"}, "read": "ws-ocpd", "expect": 60, "tolerance": 0, "unit": "A"},
  {"id": "wire-100a-al", "calc": "wire", "title": "100 A load, aluminum, 75 °C terminals", "source": "nec-310", "source_says": "Aluminum, 75 °C column: 1 AWG = 100 A",
   "press": {"cond": "al"}, "set": {"amps": "100", "wire": "thhn"}, "read": "ws-size", "expect_text": "1 AWG aluminum"},

  {"id": "vd-nec-12awg", "calc": "vd", "title": "20 A on 12 AWG copper, 100 ft, 120 V single phase", "source": "kfactor", "source_says": "2 × 12.9 × 20 A × 100 ft ÷ 6,530 cmil = 7.90 V",
   "press": {"std": "nec", "supply": "single", "cond": "cu"}, "set": {"size": "12 AWG", "len": "100", "amps": "20", "volts": "120", "pf": "1"}, "read": "vd-v", "expect": 7.90, "tolerance": 0.08, "unit": "V",
   "note": "The calculator works from resistivity at operating temperature instead of the rounded K factor, so it lands about 0.5 % higher."},
  {"id": "vd-iec-2.5", "calc": "vd", "title": "16 A on 2.5 mm² copper, 30 m, 230 V single phase", "source": "iec-g", "source_says": "2 × 0.0225 × 30 m × 16 A ÷ 2.5 mm² = 8.64 V",
   "press": {"std": "iec", "supply": "single", "cond": "cu"}, "set": {"size": "2.5 mm²", "len": "30", "amps": "16", "volts": "230", "pf": "1"}, "read": "vd-v", "expect": 8.64, "tolerance": 0.005, "unit": "V"},
  {"id": "vd-iec-3ph", "calc": "vd", "title": "40 A on 10 mm² copper, 50 m, 400 V three phase", "source": "iec-g", "source_says": "√3 × 0.0225 × 50 m × 40 A ÷ 10 mm² = 7.79 V",
   "press": {"std": "iec", "supply": "three", "cond": "cu"}, "set": {"size": "10 mm²", "len": "50", "amps": "40", "volts": "400", "pf": "1"}, "read": "vd-v", "expect": 7.79, "tolerance": 0.01, "unit": "V"},

  {"id": "coat-1mil", "calc": "coat", "title": "1,604 sq ft at 1 mil, 100 % solids, no waste", "source": "gallon", "source_says": "One US gallon covers 1,604 sq ft at 1 mil",
   "set": {"area": "1604", "mils": "1", "solids": "100", "waste": "0"}, "read": "c-gal", "expect": 1.0, "tolerance": 0.005, "unit": "gal"},
  {"id": "coat-50-solids", "calc": "coat", "title": "Spread rate of a 50 % solids product at 10 mils dry", "source": "gallon", "source_says": "1,604 × 0.50 ÷ 10 = 80.2 sq ft per gallon",
   "set": {"area": "480", "mils": "10", "solids": "50", "waste": "0"}, "read": "c-rate", "expect": 80.2, "tolerance": 0.5, "unit": "sq ft/gal",
   "note": "The page shows the spread rate as a whole number."},

